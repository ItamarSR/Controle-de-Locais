<IfModule mod_rewrite.c>
  RewriteEngine On

  # Se existir arquivo ou diretório físico, serve direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Caso contrário, encaminha tudo para o front controller
  RewriteRule ^ index.php [L]
</IfModule>

